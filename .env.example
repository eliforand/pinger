# Копия этого файла -> .env (docker compose подхватывает его автоматически).

# Адрес и порт веб-сервиса
WEB_HOST=0.0.0.0
WEB_PORT=8000

# Секрет подписи cookie-сессий — обязательно замените в продакшене
SECRET_KEY=change-me-in-production

# Уровень логирования сервиса пинга
PINGER_LOG_LEVEL=INFO

# Необязательный токен для страницы /setup (первый админ)
PINGER_SETUP_TOKEN=
