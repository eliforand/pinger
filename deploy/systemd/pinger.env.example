# Пример EnvironmentFile для systemd-юнитов pinger.
# Создайте его командой `make service-env` (скопирует в .env проекта)
# либо вручную и поправьте значения:
#   sudo install -m 600 pinger.env.example /etc/pinger/pinger.env
# Файл подключается юнитами как EnvironmentFile (путь задаёт ENV_FILE).
#
# Учтите: строки в этом файле — переменные окружения systemd, без кавычек
# и без экспорта. Комментарии начинаются с "#".

# Адрес и порт веб-сервиса
WEB_HOST=0.0.0.0
WEB_PORT=8000

# Секрет подписи cookie-сессий — обязательно замените в продакшене
SECRET_KEY=change-me-in-production

# Уровень логирования сервиса пинга
PINGER_LOG_LEVEL=INFO

# Необязательный токен для страницы /setup (первый админ)
PINGER_SETUP_TOKEN=
